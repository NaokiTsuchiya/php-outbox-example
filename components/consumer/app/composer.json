{
    "name": "myvendor/outbox-consumer",
    "description": "Consumer component for Outbox Demo (BEAR.Sunday)",
    "require": {
        "php": "^8.3",
        "bear/package": "^1.13",
        "ray/aura-sql-module": "^1.13",
        "monolog/monolog": "^3.0",
        "aws/aws-sdk-php": "^3.0",
        "doctrine/cache": "^1.0",
        "koriym/param-reader": "^1.1",
        "nikic/php-parser": "^5.7",
        "koriym/attributes": "^1.0",
        "ext-swoole": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "MyVendor\\OutboxConsumer\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MyVendor\\OutboxConsumer\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.3.0"
        }
    },
    "extra": {
        "bear-app": {
            "name": "MyVendor\\OutboxConsumer"
        }
    }
}
