{
    "name": "myvendor/outbox-demo-pump",
    "description": "Outbox Pump component (BEAR.Sunday independent)",
    "require": {
        "php": "^8.3",
        "ray/di": "^2.17",
        "aura/sql": "^5.0",
        "monolog/monolog": "^3.0",
        "aws/aws-sdk-php": "^3.0",
        "ext-swoole": "*",
        "ext-redis": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "MyVendor\\OutboxPump\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MyVendor\\OutboxPump\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.3.0"
        }
    }
}
